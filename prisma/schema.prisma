generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  APPRAISER
}

enum VehicleStatus {
  IN_RECON
  FRONTLINE
  WHOLESALE
  PENDING
  SOLD
}

enum ReconStage {
  INTAKE
  MECHANICAL
  BODY
  DETAIL
  PHOTOS
  READY
}

enum AppraisalStatus {
  DRAFT
  OFFERED
  ACCEPTED
  DECLINED
  STOCKED
}

enum VehicleCondition {
  EXCELLENT
  CLEAN
  AVERAGE
  ROUGH
}

enum InventoryKind {
  USED
  NEW
}

enum ReconLineStatus {
  PENDING
  APPROVED
  DECLINED
}

enum PhotoKind {
  RAW
  CUTOUT
  PROMO
  SPIN
}

enum IncentiveKind {
  REBATE
  BONUS
  APR
}

enum SyndicationStatus {
  DRAFT
  QUEUED
  LIVE
  ERROR
  PAUSED
}

enum InspectionSeverity {
  NOTE
  MINOR
  MAJOR
}

model Organization {
  id                       String    @id @default(cuid())
  name                     String
  slug                     String    @unique
  demoMode                 Boolean   @default(true)
  carsxeKeyCipher          String?
  carsxeKeyLast4           String?
  carsxeConnectedAt        DateTime?
  carsxeAuthMethod         String?
  carsxeAccessTokenCipher  String?
  carsxeRefreshTokenCipher String?
  carsxeTokenExpiresAt     DateTime?
  cacheTtlHours            Int       @default(24)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  users                    User[]
  rooftops                 Rooftop[]
  vehicles                 Vehicle[]
  appraisals               Appraisal[]
  apiCache                 ApiCache[]
  apiUsage                 ApiUsage[]
  incentives               IncentiveProgram[]
  sourcingCandidates       SourcingCandidate[]
  reconLines               ReconLine[]
  photos                   Photo[]
  inspections              Inspection[]
  syndicationChannels      SyndicationChannel[]
  featureFlags             FeatureFlag[]
  betaFeedback             BetaFeedback[]
}

model Rooftop {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  city               String
  state              String
  zip                String?
  agingThresholdDays     Int      @default(45)
  targetTurnDays         Int      @default(45)
  holdingCostPerDayCents Int      @default(3500)
  targetUnitsPerModel    Int      @default(2)
  createdAt              DateTime @default(now())
  users                  User[]
  vehicles               Vehicle[]
  appraisals             Appraisal[]

  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooftopId      String?
  rooftop        Rooftop? @relation(fields: [rooftopId], references: [id], onDelete: SetNull)
  email          String   @unique
  name           String
  passwordHash   String
  role           Role     @default(APPRAISER)
  createdAt      DateTime @default(now())
  appraisals     Appraisal[]
  apiUsage       ApiUsage[]
  reconApprovals ReconLine[] @relation("ReconApprover")
  betaFeedback   BetaFeedback[]

  @@index([organizationId])
}

model Vehicle {
  id                   String        @id @default(cuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooftopId            String
  rooftop              Rooftop       @relation(fields: [rooftopId], references: [id], onDelete: Restrict)
  vin                  String
  stockNumber          String
  year                 Int
  make                 String
  model                String
  trim                 String?
  bodyStyle            String?
  color                String?
  mileage              Int
  costCents            Int
  listPriceCents       Int
  marketRetailCents    Int?
  marketWholesaleCents Int?
  marketTradeInCents   Int?
  marketFetchedAt      DateTime?
  status               VehicleStatus @default(IN_RECON)
  reconStage           ReconStage    @default(INTAKE)
  acquiredAt           DateTime
  soldAt               DateTime?
  notes                  String?
  kind                   InventoryKind @default(USED)
  segment                String?
  reconSpendCents        Int           @default(0)
  holdingCostPerDayCents Int           @default(3500)
  msrpCents              Int?
  invoiceCents           Int?
  description            String?
  aiDescription          String?
  photoPackReady         Boolean       @default(false)
  certified              Boolean       @default(false)
  stageEnteredAt         DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  reconLines             ReconLine[]
  photos                 Photo[]
  spinFrames             SpinFrame[]
  inspections            Inspection[]
  syndicationListings    SyndicationListing[]

  @@unique([organizationId, vin])
  @@unique([organizationId, stockNumber])
  @@index([organizationId, status])
  @@index([organizationId, kind])
  @@index([rooftopId])
}

model Appraisal {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooftopId            String
  rooftop              Rooftop           @relation(fields: [rooftopId], references: [id], onDelete: Restrict)
  appraiserId          String
  appraiser            User              @relation(fields: [appraiserId], references: [id], onDelete: Restrict)
  vin                  String
  plate                String?
  plateState           String?
  year                 Int?
  make                 String?
  model                String?
  trim                 String?
  mileage              Int
  condition            VehicleCondition  @default(CLEAN)
  customerName         String?
  offerCents           Int?
  status               AppraisalStatus   @default(DRAFT)
  notes                String?
  marketRetailCents    Int?
  marketWholesaleCents Int?
  marketTradeInCents   Int?
  marketAuctionCents   Int?
  brandCount           Int               @default(0)
  recallCount          Int               @default(0)
  hasOpenLien          Boolean           @default(false)
  hasTheftFlag         Boolean           @default(false)
  historySummary       String?
  payload              Json?
  walkAwayCents        Int?
  counterCents         Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  inspections          Inspection[]

  @@index([organizationId, createdAt])
  @@index([rooftopId])
}

model ApiCache {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint       String
  cacheKey       String
  payload        Json
  fetchedAt      DateTime     @default(now())
  expiresAt      DateTime

  @@unique([organizationId, endpoint, cacheKey])
  @@index([expiresAt])
}

model ApiUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint       String
  action         String
  vin            String?
  billed         Boolean
  cacheHit       Boolean
  demo           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model IncentiveProgram {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  make           String
  model          String?
  year           Int?
  amountCents    Int
  kind           IncentiveKind @default(REBATE)
  source         String        @default("MANUAL")
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, make])
}

model SourcingCandidate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vin            String
  year           Int
  make           String
  model          String
  trim           String?
  segment        String?
  mileage        Int
  askingCents    Int
  sourceName     String
  adapter        String
  payload        Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model ReconLine {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title          String
  category       String
  estimateCents  Int
  status         ReconLineStatus @default(PENDING)
  vendor         String?
  stage          ReconStage      @default(MECHANICAL)
  notes          String?
  approvedById   String?
  approvedBy     User?           @relation("ReconApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  decidedAt      DateTime?

  @@index([organizationId, status])
  @@index([vehicleId])
}

model Photo {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind           PhotoKind    @default(RAW)
  url            String
  overlay        String?
  createdAt      DateTime     @default(now())

  @@index([vehicleId])
}

model SpinFrame {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  index     Int
  url       String

  @@unique([vehicleId, index])
}

model Inspection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appraisalId    String?
  appraisal      Appraisal?   @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  grade          String
  provider       String       @default("manual")
  imageUrl       String?
  notes          String?
  createdAt      DateTime     @default(now())
  tags           InspectionTag[]

  @@index([organizationId])
}

model InspectionTag {
  id           String              @id @default(cuid())
  inspectionId String
  inspection   Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  x            Float
  y            Float
  label        String
  severity     InspectionSeverity  @default(MINOR)
  notes        String?
}

model SyndicationChannel {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  adapter        String               @default("lotdesk-feed")
  format         String               @default("json")
  enabled        Boolean              @default(true)
  listings       SyndicationListing[]

  @@unique([organizationId, slug])
}

model SyndicationListing {
  id         String             @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  channelId  String
  channel    SyndicationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status     SyndicationStatus  @default(DRAFT)
  lastSyncAt DateTime?
  error      String?

  @@unique([vehicleId, channelId])
}

model FeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
}

model BetaFeedback {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  flagKey        String
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())
}
