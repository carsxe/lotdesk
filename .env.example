# Application
APP_URL=http://127.0.0.1:43173
AUTH_URL=http://127.0.0.1:43173
AUTH_SECRET=replace-with-openssl-rand-base64-32
DATABASE_URL=postgresql://lotdesk:lotdesk@127.0.0.1:5432/lotdesk

# AES-256 key for CarsXE credentials at rest (64 hex chars or any passphrase)
ENCRYPTION_KEY=0000111122223333444455556666777788889999aaaabbbbccccddddeeeeffff

# Docker entrypoint only: seed demo users/inventory. docker compose sets this.
# Leave unset/false on Railway, Render, and any public host.
SEED_DEMO_DATA=false

# Public CarsXE API. Override only if you run a compatible proxy.
CARSXE_API_BASE_URL=https://api.carsxe.com

# Optional OAuth 2.0 Authorization Code + PKCE.
# Leave blank until CarsXE publishes a provider. API key connect works without these.
CARSXE_OAUTH_AUTHORIZE_URL=
CARSXE_OAUTH_TOKEN_URL=
CARSXE_OAUTH_CLIENT_ID=
CARSXE_OAUTH_CLIENT_SECRET=
CARSXE_OAUTH_SCOPES=vehicle:read
CARSXE_OAUTH_REDIRECT_URI=http://127.0.0.1:43173/api/oauth/callback

# Pluggable providers. demo / manual work with no keys.
# http posts to *_URL with optional Bearer *_KEY. openai uses AI_PROVIDER_KEY.
AI_PROVIDER=demo
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=
IMAGE_PROVIDER=demo
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_KEY=
INSPECTION_PROVIDER=demo
INSPECTION_PROVIDER_URL=
INSPECTION_PROVIDER_KEY=
INCENTIVE_ADAPTER=manual
INCENTIVE_ADAPTER_URL=
INCENTIVE_ADAPTER_KEY=
SOURCE_ADAPTER=csv
SYNDICATION_ADAPTER=lotdesk-feed
